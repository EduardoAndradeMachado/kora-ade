{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "relay/**/*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "scripts/**/*", "test/**/*"]
}
