{
  "name": "kora",
  "productName": "Kora ADE",
  "version": "0.1.7",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9333",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint src test",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && oxlint src test && vitest run",
    "e2e": "playwright test",
    "e2e:mutantes": "node e2e/mutantes.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "electron-updater": "6.8.9",
    "koffi": "3.3.1",
    "node-pty": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "marked": "18.0.14",
    "monaco-editor": "0.56.0",
    "oxlint": "1.85.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi",
      "node-pty"
    ]
  },
  "description": "Ambiente de desenvolvimento com agentes (Claude Code e Codex) por projeto",
  "author": "Eduardo Andrade Machado",
  "homepage": "https://kora-ade.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/EduardoAndradeMachado/kora-ade.git"
  },
  "bugs": {
    "url": "https://github.com/EduardoAndradeMachado/kora-ade/issues"
  }
}
